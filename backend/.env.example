# MongoDB connection string
DB_URI=mongodb://localhost:27017/inventory-management

# JWT secret used to sign auth tokens
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:3000

# Email credentials (used by nodemailer for password reset)
EMAIL_HOST=smtp.example.com
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Cloudinary credentials (used for product image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Node environment
NODE_ENV=development
